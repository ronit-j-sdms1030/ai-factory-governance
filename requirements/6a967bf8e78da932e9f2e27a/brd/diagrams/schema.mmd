erDiagram
    Item ||--o{ WriteOff : "has"
    Item {
        string sku PK
        string description
        integer current_stock
        string category
        string storage_location
    }
    User ||--o{ WriteOff : "submits"
    User {
        string employee_id PK
        string name
        enum role
        string password_hash
        boolean is_active
    }
    WriteOff ||--|| InventoryTransaction : "triggers"
    WriteOff {
        uuid writeoff_id PK
        string sku FK
        string employee_id FK
        enum damage_reason
        string photo_s3_key
        decimal submitted_value
        enum value_source
        enum severity_tier
        decimal defect_pixel_percentage
        enum status
        timestamp submitted_at
        string reviewed_by FK
        timestamp reviewed_at
        string review_comment
    }
    InventoryTransaction {
        uuid transaction_id PK
        string sku FK
        uuid writeoff_id FK
        integer quantity_change
        integer resulting_stock
        timestamp timestamp
    }
    User ||--o{ WriteOff : "reviews"