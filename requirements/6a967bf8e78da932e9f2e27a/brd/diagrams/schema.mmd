erDiagram
    item ||--o{ write_off : "has"
    write_off ||--o{ write_off_photo : "includes"
    user ||--o{ write_off : "submits"
    user ||--o{ write_off : "approves"
    write_off ||--o{ audit_log : "generates"
    
    item {
        string sku PK
        string upc_ean UK
        string description
        string category
        decimal unit_cost
        integer current_stock
        string status
        timestamp last_updated
    }
    
    write_off {
        uuid write_off_id PK
        string sku FK
        uuid submitted_by FK
        timestamp submitted_at
        string reason
        integer quantity
        integer ai_severity_score
        uuid supervisor_approved_by FK
        timestamp approved_at
        string status
        text notes
        decimal total_value
        boolean is_unknown_item
        string sync_status
    }
    
    write_off_photo {
        uuid photo_id PK
        uuid write_off_id FK
        string photo_type
        string azure_blob_url
        string local_path
        timestamp uploaded_at
        integer file_size
        json ai_analysis_json
        string sync_status
    }
    
    user {
        uuid employee_id PK
        string azure_ad_id UK
        string full_name
        string email
        string role
        string warehouse_location
        boolean is_active
    }
    
    audit_log {
        uuid log_id PK
        uuid write_off_id FK
        uuid user_id FK
        string action
        timestamp timestamp
        string ip_address
        string user_agent
        integer quantity_affected
    }